@model FilmSearchApi.Models.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FilmSearch</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4c1d95 100%);
            padding: 20px;
        }

        .register-card {
            width: 100%;
            max-width: 440px;
            background: rgba(255, 255, 255, 0.98);
            border-radius: 20px;
            padding: 40px 36px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.35),
                        0 0 0 1px rgba(255, 255, 255, 0.1);
            animation: slideIn 0.4s ease-out;
        }

        @@keyframes slideIn {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .register-card h1 {
            font-size: 26px;
            font-weight: 700;
            color: #1e1b4b;
            text-align: center;
            margin-bottom: 6px;
        }

        .register-card .subtitle {
            text-align: center;
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 28px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #374151;
            margin-bottom: 6px;
        }

        .form-group input[type="text"],
        .form-group input[type="email"],
        .form-group input[type="password"] {
            width: 100%;
            padding: 12px 14px;
            font-size: 15px;
            border: 1.5px solid #e5e7eb;
            border-radius: 10px;
            background: #f9fafb;
            transition: all 0.2s ease;
            outline: none;
            color: #111827;
        }

        .form-group input:focus {
            border-color: #6366f1;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12);
        }

        .form-group input.input-validation-error {
            border-color: #ef4444;
            background: #fef2f2;
        }

        .field-validation-error {
            display: block;
            color: #ef4444;
            font-size: 12.5px;
            margin-top: 5px;
        }

        /* Скрываем плашку, когда ошибок нет */
        .validation-summary-valid {
            display: none !important;
        }

        .validation-summary-errors {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 20px;
            font-size: 13.5px;
        }

        .validation-summary-errors ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .validation-summary-errors li + li {
            margin-top: 4px;
        }

        .btn-submit {
            width: 100%;
            padding: 13px;
            font-size: 15px;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-top: 8px;
        }

        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.35);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .login-link {
            text-align: center;
            margin-top: 22px;
            font-size: 14px;
            color: #6b7280;
        }

        .login-link a {
            color: #6366f1;
            font-weight: 600;
            text-decoration: none;
        }

        .login-link a:hover {
            text-decoration: underline;
        }

        @@media (prefers-color-scheme: dark) {
            body {
                background: linear-gradient(135deg, #0f0f23 0%, #1a1a3e 100%);
            }
            .register-card { background: rgba(30, 30, 50, 0.98); }
            .register-card h1 { color: #e0e7ff; }
            .form-group label { color: #c7d2fe; }
            .form-group input {
                background: #1e1e3a;
                border-color: #374151;
                color: #f3f4f6;
            }
            .form-group input:focus { background: #252547; }
            .register-card .subtitle { color: #9ca3af; }
            .login-link { color: #9ca3af; }
        }
    </style>
</head>
<body>
    <div class="register-card">
        <h1>Создать аккаунт</h1>
        <p class="subtitle">Присоединяйтесь к FilmSearch</p>

        <form action="/Account/Register" method="post" novalidate>
            @Html.AntiForgeryToken()

            @* Показываем все ошибки — и модельные, и полевые *@
            @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email"
                       placeholder="you@example.com"
                       autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password"
                       placeholder="Минимум 8 символов"
                       autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" type="password"
                       placeholder="Повторите пароль"
                       autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-submit">Зарегистрироваться</button>
        </form>

        <div class="login-link">
            Уже есть аккаунт? <a href="/Account/Login">Войти</a>
        </div>
    </div>
</body>
</html>