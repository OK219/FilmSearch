@model FilmSearchApi.Models.FilmListViewModel
@using FilmSearchApi.DB
@{
    ViewData["Title"] = "Каталог фильмов";
    var filter = Model.Filter;
    var results = Model.Results;
}

<style>
    .catalog-container {
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
        padding: 40px 20px;
    }

    .catalog-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .catalog-title {
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -0.5px;
        color: #e0e7ff;
    }

    .catalog-add-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: #fff;
        text-decoration: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .catalog-add-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 20px rgba(99, 102, 241, 0.35);
    }

    /* ===== Форма фильтрации ===== */
    .filter-bar {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 28px;
    }

    .filter-row {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1.3fr 1.3fr auto;
        gap: 14px;
        align-items: end;
    }

    .filter-field label {
        display: block;
        font-size: 12.5px;
        font-weight: 600;
        color: #c7d2fe;
        margin-bottom: 6px;
    }

    .filter-field input,
    .filter-field select {
        width: 100%;
        padding: 10px 12px;
        font-size: 14px;
        font-family: inherit;
        border: 1.5px solid rgba(199, 210, 254, 0.2);
        border-radius: 10px;
        background: rgba(15, 15, 35, 0.5);
        color: #f3f4f6;
        outline: none;
        transition: all 0.2s ease;
    }

    .filter-field input:focus,
    .filter-field select:focus {
        border-color: #8b5cf6;
        box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.15);
    }

    .filter-field input[type="date"]::-webkit-calendar-picker-indicator {
        filter: invert(0.8);
        cursor: pointer;
    }

    .filter-actions {
        display: flex;
        gap: 8px;
    }

    .btn-apply {
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-family: inherit;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .btn-apply:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 16px rgba(99, 102, 241, 0.35);
    }

    .btn-reset {
        padding: 10px 16px;
        font-size: 14px;
        font-weight: 600;
        color: #c7d2fe;
        background: transparent;
        border: 1.5px solid rgba(199, 210, 254, 0.3);
        border-radius: 10px;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .btn-reset:hover {
        border-color: rgba(199, 210, 254, 0.6);
        background: rgba(199, 210, 254, 0.1);
    }

    /* ===== Сетка фильмов ===== */
    .films-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 24px;
        margin-bottom: 40px;
    }

    .film-card {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
    }

    .film-card:hover {
        transform: translateY(-4px);
        background: rgba(255, 255, 255, 0.09);
        border-color: rgba(139, 92, 246, 0.5);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .film-poster {
        aspect-ratio: 2 / 3;
        background: linear-gradient(135deg, #1e1b4b, #4c1d95);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .film-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .film-poster .no-poster {
        font-size: 56px;
        opacity: 0.4;
    }

    .film-info {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex: 1;
    }

    .film-info h3 {
        font-size: 16px;
        font-weight: 700;
        color: #e0e7ff;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .film-meta {
        font-size: 13px;
        color: #a5b4fc;
        margin-top: auto;
        padding-top: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }

    .film-rating {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        color: #fbbf24;
        font-weight: 600;
    }

    .film-rating.no-rating {
        color: #6b7280;
        font-weight: 400;
    }

    /* ===== Пусто ===== */
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #a5b4fc;
        grid-column: 1 / -1;
    }

    .empty-state .icon {
        font-size: 64px;
        margin-bottom: 16px;
        opacity: 0.5;
    }

    /* ===== Пагинация ===== */
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .pagination button,
    .pagination span {
        min-width: 40px;
        height: 40px;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .pagination button {
        color: #c7d2fe;
        background: rgba(255, 255, 255, 0.06);
    }

    .pagination button:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(139, 92, 246, 0.5);
    }

    .pagination .current {
        color: #fff;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        border: none;
        cursor: default;
    }

    .pagination .disabled {
        color: #6b7280;
        background: rgba(255, 255, 255, 0.03);
        cursor: not-allowed;
    }

    .pagination .info {
        color: #a5b4fc;
        font-size: 13px;
        font-weight: 400;
        cursor: default;
    }

    .catalog-summary {
        text-align: center;
        margin-top: 16px;
        font-size: 13px;
        color: #a5b4fc;
    }

    @* ---------- Адаптив ---------- *@
    @@media (max-width: 900px) {
        .filter-row {
            grid-template-columns: 1fr 1fr;
        }
        .filter-actions {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 640px) {
        .catalog-container { padding: 20px 12px; }
        .catalog-title { font-size: 24px; }
        .films-grid { gap: 14px; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
        .film-info { padding: 12px; }
        .film-info h3 { font-size: 14px; }
        .filter-row { grid-template-columns: 1fr; }
    }
</style>

<div class="catalog-container">

    <div class="catalog-header">
        <h1 class="catalog-title">Каталог фильмов</h1>

        @* Кнопка "Добавить" — видна только админу *@
        @using Microsoft.AspNetCore.Authorization
        @inject IAuthorizationService AuthService
        @if ((await AuthService.AuthorizeAsync(User, "AdminOnly")).Succeeded)
        {
            <a href="/Film/Add" class="catalog-add-btn">
                <span>+</span> Добавить фильм
            </a>
        }
    </div>

    @* ===== Вся страница — одна форма ===== *@
    @* Пагинация работает через submit-кнопки с name="page" *@
    <form method="post" action="/Film" novalidate>
        @Html.AntiForgeryToken()

        @* ---- Панель фильтров ---- *@
        <div class="filter-bar">
            <div class="filter-row">

                <div class="filter-field">
                    <label for="Name">Название</label>
                    <input type="text" id="Name" name="Name"
                           value="@filter.Name" placeholder="Поиск по названию" />
                </div>

                <div class="filter-field">
                    <label for="MinDate">Дата от</label>
                    <input type="date" id="MinDate" name="MinDate"
                           value="@(filter.MinDate == DateOnly.MinValue ? "" : filter.MinDate.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="filter-field">
                    <label for="MaxDate">Дата до</label>
                    <input type="date" id="MaxDate" name="MaxDate"
                           value="@(filter.MaxDate == DateOnly.MaxValue ? "" : filter.MaxDate.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="filter-field">
                    <label for="OrderBy">Сортировка</label>
                    <select id="OrderBy" name="OrderBy">
                        <option value="0" selected="@(filter.OrderBy == FilmOrder.None ? "selected" : null)">Без сортировки</option>
                        <option value="1" selected="@(filter.OrderBy == FilmOrder.ByName ? "selected" : null)">По названию</option>
                        <option value="2" selected="@(filter.OrderBy == FilmOrder.ByRating ? "selected" : null)">По рейтингу</option>
                        <option value="3" selected="@(filter.OrderBy == FilmOrder.ByDate ? "selected" : null)">По дате</option>
                    </select>
                </div>

                <div class="filter-field">
                    <label for="IsDescending">Порядок</label>
                    <select id="IsDescending" name="IsDescending">
                        <option value="false" selected="@(!filter.IsDescending ? "selected" : null)">По возрастанию</option>
                        <option value="true" selected="@(filter.IsDescending ? "selected" : null)">По убыванию</option>
                    </select>
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn-apply">Применить</button>
                    <a href="/Film" class="btn-reset">Сбросить</a>
                </div>

            </div>
        </div>

        @* ---- Результаты ---- *@
        @if (results.Items.Count == 0)
        {
            <div class="empty-state">
                <div class="icon">🔍</div>
                <h2>Ничего не найдено</h2>
                <p style="margin-top: 8px;">Попробуйте изменить параметры фильтрации.</p>
            </div>
        }
        else
        {
            <div class="films-grid">
                @foreach (var film in results.Items)
                {
                    <a href="/Film/Details?Id=@film.Id" class="film-card">
                        <div class="film-poster">
                            @if (!string.IsNullOrEmpty(film.PosterKey))
                            {
                                <img src="@film.PosterKey" alt="@film.Name" loading="lazy" />
                            }
                            else
                            {
                                <span class="no-poster">🎬</span>
                            }
                        </div>
                        <div class="film-info">
                            <h3>@film.Name</h3>
                            <div class="film-meta">
                                <span>@(film.GenreName ?? "—") · @film.ReleaseDate.Year</span>
                                @if (film.AverageRating.HasValue)
                                {
                                    <span class="film-rating">★ @film.AverageRating.Value.ToString("0.0")</span>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>

            @* ---- Пагинация — кнопки внутри формы ---- *@
            @if (results.TotalPages > 1)
            {
                <div class="pagination">
                    @if (results.HasPrevious)
                    {
                        <button type="submit" name="page" value="@(results.Page - 1)">← Назад</button>
                    }
                    else
                    {
                        <span class="disabled">← Назад</span>
                    }

                    @{
                        var start = Math.Max(1, results.Page - 2);
                        var end = Math.Min(results.TotalPages, results.Page + 2);
                    }

                    @if (start > 1)
                    {
                        <button type="submit" name="page" value="1">1</button>
                        if (start > 2)
                        {
                            <span class="info">…</span>
                        }
                    }

                    @for (int i = start; i <= end; i++)
                    {
                        if (i == results.Page)
                        {
                            <span class="current">@i</span>
                        }
                        else
                        {
                            <button type="submit" name="page" value="@i">@i</button>
                        }
                    }

                    @if (end < results.TotalPages)
                    {
                        if (end < results.TotalPages - 1)
                        {
                            <span class="info">…</span>
                        }
                        <button type="submit" name="page" value="@results.TotalPages">@results.TotalPages</button>
                    }

                    @if (results.HasNext)
                    {
                        <button type="submit" name="page" value="@(results.Page + 1)">Вперёд →</button>
                    }
                    else
                    {
                        <span class="disabled">Вперёд →</span>
                    }
                </div>

                <div class="catalog-summary">
                    Всего фильмов: @results.TotalCount · Страница @results.Page из @results.TotalPages
                </div>
            }
        }
    </form>
</div>