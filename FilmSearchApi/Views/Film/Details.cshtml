@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthService
@{
    ViewData["Title"] = Model.Name;
    var isAdmin = (await AuthService.AuthorizeAsync(User, "AdminOnly")).Succeeded;
}

<style>
    .details-container {
        max-width: 1100px;
        margin: 0 auto;
        width: 100%;
        padding: 40px 20px;
    }

    .details-top {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 40px;
        margin-bottom: 48px;
    }

    .details-poster {
        aspect-ratio: 2 / 3;
        background: linear-gradient(135deg, #1e1b4b, #4c1d95);
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 80px;
        opacity: 0.85;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .details-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .details-info h1 {
        font-size: 36px;
        font-weight: 800;
        color: #e0e7ff;
        margin-bottom: 12px;
        line-height: 1.2;
    }

    .details-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 20px;
        color: #a5b4fc;
        font-size: 15px;
    }

    .details-rating {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: rgba(251, 191, 36, 0.12);
        border: 1px solid rgba(251, 191, 36, 0.3);
        border-radius: 10px;
        color: #fbbf24;
        font-weight: 700;
        font-size: 16px;
    }

    .details-rating.no-rating {
        background: rgba(107, 114, 128, 0.12);
        border-color: rgba(107, 114, 128, 0.3);
        color: #9ca3af;
        font-weight: 400;
    }

    .details-rating-count {
        color: #a5b4fc;
        font-size: 13px;
        font-weight: 400;
        margin-left: 4px;
    }

    .details-description {
        font-size: 16px;
        color: #c7d2fe;
        line-height: 1.7;
        white-space: pre-line;
    }

    /* ===== Отзывы ===== */
    .reviews-section h2 {
        font-size: 22px;
        font-weight: 700;
        color: #e0e7ff;
        margin-bottom: 20px;
    }

    /* Форма */
    .review-form {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 32px;
    }

    .review-form h3 {
        font-size: 17px;
        font-weight: 700;
        color: #e0e7ff;
        margin-bottom: 16px;
    }

    .review-form .form-group {
        margin-bottom: 16px;
    }

    .review-form label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #c7d2fe;
        margin-bottom: 6px;
    }

    .review-form input[type="number"],
    .review-form textarea {
        width: 100%;
        padding: 12px 14px;
        font-size: 15px;
        font-family: inherit;
        border: 1.5px solid rgba(199, 210, 254, 0.2);
        border-radius: 10px;
        background: rgba(15, 15, 35, 0.5);
        color: #f3f4f6;
        transition: all 0.2s ease;
        outline: none;
    }

    .review-form input[type="number"] {
        width: 100px;
    }

    .review-form textarea {
        min-height: 100px;
        resize: vertical;
    }

    .review-form input:focus,
    .review-form textarea:focus {
        border-color: #8b5cf6;
        box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.15);
    }

    .btn-submit {
        padding: 12px 24px;
        font-size: 15px;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: inherit;
    }

    .btn-submit:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 20px rgba(99, 102, 241, 0.35);
    }

    .login-prompt {
        background: rgba(99, 102, 241, 0.1);
        border: 1px solid rgba(99, 102, 241, 0.3);
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        color: #c7d2fe;
        font-size: 15px;
        margin-bottom: 32px;
    }

    .login-prompt a {
        color: #8b5cf6;
        font-weight: 600;
        text-decoration: none;
    }

    .login-prompt a:hover {
        text-decoration: underline;
    }

    /* Список отзывов */
    .reviews-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .review-item {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 14px;
        padding: 20px;
    }

    .review-item.mine {
        border-color: rgba(139, 92, 246, 0.5);
        background: rgba(139, 92, 246, 0.08);
    }

    .review-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        flex-wrap: wrap;
        gap: 8px;
    }

    .review-author {
        font-size: 14px;
        font-weight: 600;
        color: #c7d2fe;
        word-break: break-all;
    }

    .review-author .you {
        color: #a78bfa;
        font-weight: 700;
        margin-left: 6px;
        font-size: 12px;
    }

    .review-score {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: #fbbf24;
        font-weight: 700;
        font-size: 15px;
    }

    .review-score .max {
        color: #6b7280;
        font-weight: 400;
        font-size: 13px;
    }

    .review-body {
        font-size: 14.5px;
        color: #e0e7ff;
        line-height: 1.6;
        white-space: pre-line;
        word-wrap: break-word;
    }

    .review-body.empty {
        font-style: italic;
        color: #6b7280;
    }

    .reviews-empty {
        text-align: center;
        padding: 40px 20px;
        color: #a5b4fc;
    }

    .reviews-empty .icon {
        font-size: 48px;
        opacity: 0.5;
        margin-bottom: 12px;
    }

    .alert-error {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #fca5a5;
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 13.5px;
    }

    @@media (max-width: 768px) {
        .details-top {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .details-poster {
            max-width: 240px;
            margin: 0 auto;
        }

        .details-info h1 {
            font-size: 26px;
        }
    }
</style>

<div class="details-container">

    @* ===== Шапка фильма ===== *@
    <div class="details-top">
        <div class="details-poster">
            @if (!string.IsNullOrEmpty(Model.PosterUrl))
            {
                <img src="@Model.PosterUrl" alt="@Model.Name" />
            }
            else
            {
                <span>🎬</span>
            }
        </div>

        <div class="details-info">
            <div class="details-info-header">
                <h1>@Model.Name</h1>

                @if (isAdmin)
                {
                    <form action="/Film/DeleteFilm" method="post" class="delete-film-form"
                          onsubmit="return confirm('Удалить фильм «@Model.Name»? Все отзывы тоже будут удалены.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn-danger">Удалить фильм</button>
                    </form>
                }
            </div>

            @* ... остальной блок .details-info без изменений ... *@
        </div>
    </div>

    @* ===== Отзывы ===== *@
    <div class="reviews-section">
        <h2>Отзывы</h2>

        @if (TempData["ReviewError"] is string err)
        {
            <div class="alert-error">@err</div>
        }

        @if (Model.CanReview)
        {
            <div class="review-form">
                <h3>
                    @if (Model.UserReview is not null)
                    {
                        <text>Изменить ваш отзыв</text>
                    }
                    else
                    {
                        <text>Оставить отзыв</text>
                    }
                </h3>

                <form action="/Film/AddReview" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="filmId" value="@Model.Id" />

                    <div class="form-group">
                        <label for="rating">Оценка (1–10)</label>
                        <input type="number" id="rating" name="rating" min="1" max="10"
                               value="@(Model.UserReview?.Rating ?? 8)" required />
                    </div>

                    <div class="form-group">
                        <label for="reviewText">Текст отзыва (необязательно)</label>
                        <textarea id="reviewText" name="reviewText"
                                  placeholder="Поделитесь впечатлениями о фильме">@Model.UserReview?.ReviewText</textarea>
                    </div>

                    <button type="submit" class="btn-submit">
                        @(Model.UserReview is not null ? "Обновить отзыв" : "Отправить отзыв")
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="login-prompt">
                <a href="/Account/Login?returnUrl=/Film/Details/@Model.Id">Войдите</a>,
                чтобы оставить отзыв
            </div>
        }

        @if (Model.Reviews.Count == 0)
        {
            <div class="reviews-empty">
                <div class="icon">💬</div>
                <p>Пока нет отзывов. Будьте первым!</p>
            </div>
        }
        else
        {
            <div class="reviews-list">
                @foreach (var review in Model.Reviews)
                {
                    <div class="review-item @(review.IsCurrentUser ? "mine" : "")">
                        <div class="review-head">
                            <div class="review-author">
                                @review.UserEmail
                                @if (review.IsCurrentUser)
                                {
                                    <span class="you">(это вы)</span>
                                }
                            </div>

                            <div class="review-actions">
                                <div class="review-score">
                                    ★ @review.Rating <span class="max">/ 10</span>
                                </div>

                                @if (review.IsCurrentUser)
                                {
                                    <form action="/Film/DeleteReview" method="post"
                                          onsubmit="return confirm('Удалить ваш отзыв?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="filmId" value="@Model.Id" />
                                        <button type="submit" class="btn-delete-review" title="Удалить отзыв">✕</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>