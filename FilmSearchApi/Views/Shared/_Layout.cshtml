@using System.Security.Claims
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FilmSearch</title>
    <style>
        /* ===== Общие стили ===== */
        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            min-height: 100%;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4c1d95 100%);
            background-attachment: fixed;
            color: #f3f4f6;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ===== Шапка ===== */
        .app-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 40px;
            background: rgba(15, 15, 35, 0.5);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .app-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 20px;
            font-weight: 700;
            color: #e0e7ff;
            letter-spacing: -0.5px;
            text-decoration: none;
        }

        .app-logo-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .app-nav {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .app-nav a,
        .app-nav button {
            font-family: inherit;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
            color: #c7d2fe;
            background: transparent;
        }

        .app-nav a:hover,
        .app-nav button:hover {
            background: rgba(199, 210, 254, 0.1);
        }

        .app-nav .nav-primary {
            color: #fff;
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        }

        .app-nav .nav-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 16px rgba(99, 102, 241, 0.35);
        }

        .app-nav .nav-ghost {
            border: 1.5px solid rgba(199, 210, 254, 0.3);
        }

        .app-nav .nav-ghost:hover {
            border-color: rgba(199, 210, 254, 0.6);
        }

        .app-user {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: #a5b4fc;
            padding: 0 8px;
        }

        .app-user-email {
            max-width: 180px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* ===== Контент ===== */
        .app-main {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        /* ===== Футер ===== */
        .app-footer {
            padding: 20px 40px;
            text-align: center;
            font-size: 13px;
            color: rgba(199, 210, 254, 0.5);
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* ===== Адаптив ===== */
        @@media (max-width: 640px) {
            .app-header { padding: 12px 16px; }
            .app-logo { font-size: 17px; }
            .app-logo-icon { width: 28px; height: 28px; font-size: 15px; }
            .app-nav a, .app-nav button { padding: 6px 10px; font-size: 13px; }
            .app-user-email { display: none; }
            .app-footer { padding: 16px 20px; }
        }
    </style>

    @* Сюда страницы добавляют свои стили *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @* ===== Шапка сайта ===== *@
    <header class="app-header">
        <a href="/" class="app-logo">
            <span class="app-logo-icon">🎬</span>
            FilmSearch
        </a>

        <nav class="app-nav">
            <a href="/Film">Каталог</a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                var email = User.FindFirst(ClaimTypes.Email)?.Value ?? "";

                <div class="app-user">
                    <span class="app-user-email">@email</span>
                </div>
                <a href="/Account/Index" class="nav-ghost">Профиль</a>

                <form action="/Account/Logout" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-ghost">Выйти</button>
                </form>
            }
            else
            {
                <a href="/Account/Login" class="nav-ghost">Войти</a>
                <a href="/Account/Register" class="nav-primary">Регистрация</a>
            }
        </nav>
    </header>

    @* ===== Содержимое страницы ===== *@
    <main class="app-main">
        @RenderBody()
    </main>

    @* ===== Футер ===== *@
    <footer class="app-footer">
        © @DateTime.UtcNow.Year FilmSearch. Учебный проект на ASP.NET Core + PostgreSQL.
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>